# Copie este arquivo para backend/.env e preencha com seus valores reais.
PORT=4000
# No EasyPanel/Docker use NODE_ENV=production. Localmente, deixe a variavel ausente.
TRUST_PROXY_HOPS=0
# Em producao, liste origens extras separadas por virgula. PUBLIC_APP_URL ja e incluida automaticamente.
CORS_ALLOWED_ORIGINS=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=curso
DATABASE_USER=postgres
DATABASE_PASSWORD=troque-esta-senha
# Use verify-full com certificado valido; use disable apenas em rede local controlada.
DATABASE_SSL=disable
# Opcional: use a URL completa do banco em vez dos campos acima
DATABASE_URL=postgres://postgres:troque-esta-senha@localhost:5432/curso?sslmode=disable
SESSION_SECRET=troque-este-segredo
AI_CONFIG_SECRET=troque-este-segredo-ai
ADMIN_JSON_BODY_LIMIT=50mb
STUDENT_JSON_BODY_LIMIT=50mb
# No EasyPanel, monte um volume persistente neste caminho.
THREE_D_STORAGE_DIR=/app/storage/3d
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BIOMETRIC_DATA_KEY=
# Local: http://127.0.0.1:8081. Docker/EasyPanel: use o hostname privado do servico.
FACE_SERVICE_URL=http://127.0.0.1:8081
FACE_SERVICE_INTERNAL_TOKEN=troque-este-token-interno-facial
FACE_MODEL_VERSION=opencv-sface-2021dec-mediapipe-v2
# Politica conservadora: score cosseno minimo, consenso e quadros independentes.
FACE_COSINE_THRESHOLD=0.55
FACE_MATCH_CONSENSUS_RATIO=0.75
FACE_MIN_MATCH_FRAMES=6
FACE_MAX_EMBEDDING_FRAMES=12
PIXIAN_USERNAME=coloque-seu-usuario-pixian-aqui
PIXIAN_PASSWORD=coloque-sua-senha-pixian-aqui
PIXIAN_TEST_MODE=true
PUBLIC_APP_URL=http://localhost:4000
ASAAS_ENV=sandbox
ASAAS_API_KEY=coloque-sua-chave-api-do-asaas-aqui
ASAAS_WEBHOOK_AUTH_TOKEN=coloque-um-token-forte-do-webhook-aqui
ASAAS_WEBHOOK_ENFORCE_SOURCE_IP=false
# Opcional. Em producao, use os IPs oficiais do Asaas separados por virgula.
ASAAS_WEBHOOK_ALLOWED_IPS=52.67.12.206,18.230.8.159,54.94.136.112,54.94.183.101
ASAAS_PRO_MONTHLY_PRICE=97.90
ASAAS_PRO_PLATFORM_CREDITS=100
ASAAS_TRIAL_PLATFORM_CREDITS=10
ASAAS_TRIAL_DAYS=30
ASAAS_APP_NAME=Criatyve/1.0
# Meta Conversions API: gere o token no Gerenciador de Eventos e mantenha-o apenas no backend.
META_PIXEL_ID=1067171249057361
META_CONVERSIONS_API_ACCESS_TOKEN=
# Opcional: use apenas enquanto testa os eventos do servidor no Gerenciador de Eventos.
META_CAPI_TEST_EVENT_CODE=
# Opcional: substitua quando a Meta publicar uma versao mais recente da Graph API.
META_GRAPH_API_VERSION=v24.0
